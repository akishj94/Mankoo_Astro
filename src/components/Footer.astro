
---
interface Props {
  settings?: any;
}

const { settings } = Astro.props;

const emails = settings?.email ?? [];
const phones = settings?.phone ?? [];
const columns = settings?.footerNavigation ?? [];
const socialLinks = settings?.socialLinks ?? [];
const legalLinks = settings?.legalLinks ?? [];

const logo = settings?.footerLogoUrl || settings?.logoUrl;

const logoAlt =
  settings?.footerLogoAlt ||
  settings?.logoAlt ||
  settings?.siteName ||
  "";

const mapsUrl = settings?.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(settings.address)}`
  : "";

// Generate internal URLs
const getInternalUrl = (ref: any) => {
  if (!ref?.slug) return "";

  if (ref._type === "post") {
    return `/blog/${ref.slug}`;
  }

  if (ref._type === "product") {
    return `/product/${ref.slug}`;
  }

  return ref.slug === "home" ? "/" : `/${ref.slug}`;
};

// Generate navigation URLs
const getLinkUrl = (link: any) => {
  if (!link) return "";

  if (link.linkType === "external") {
    return link.externalUrl || "";
  }

  return getInternalUrl(link.internalLink);
};
---

<footer class="border-t border-white/10 text-white">

  <div class="container py-12 md:py-16">

    <div class="flex flex-col gap-12 lg:flex-row lg:items-start">

      <!-- Brand and Contact -->
      <div class="lg:w-72 lg:shrink-0">

        {logo && (
          <a
            href="/"
            class="inline-flex rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <img
              src={logo}
              alt={logoAlt}
              loading="lazy"
              class="h-8 w-auto"
            />
          </a>
        )}

        {(emails.length > 0 || phones.length > 0 || settings?.address) && (
          <ul class="mt-6 space-y-3 text-sm text-white/60">

            {emails.filter(Boolean).map((email: string) => (
              <li>
                <a
                  href={`mailto:${email}`}
                  class="transition-colors hover:text-accent"
                >
                  {email}
                </a>
              </li>
            ))}

            {settings?.address && (
              <li>
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block max-w-[34ch] transition-colors hover:text-accent"
                >
                  {settings.address}
                </a>
              </li>
            )}

            {phones.filter(Boolean).map((phone: string) => (
              <li>
                <a
                  href={`tel:${phone.replace(/[^\d+]/g, "")}`}
                  class="transition-colors hover:text-accent"
                >
                  {phone}
                </a>
              </li>
            ))}

          </ul>
        )}

      </div>

      <!-- Footer Navigation -->
      {columns.length > 0 && (
        <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:ml-auto lg:flex lg:gap-x-16">

          {columns.map((column: any) => {

            const isSocialMenu = column.menuType === "social";

            const links = isSocialMenu
              ? socialLinks
              : (column.links ?? []);

            if (!links.length) return null;

            return (
              <nav
                aria-label={column.title}
                class="lg:w-40"
              >

                <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-white/40">
                  {column.title}
                </h2>

                <ul class="mt-6 space-y-2 text-sm">

                  
                  {links.map((link: any) => {
                    const href = isSocialMenu
                      ? link.url
                      : getLinkUrl(link);

                    const external = isSocialMenu ||
                      link.linkType === "external";

                    return (
                      <li>
                        {href ? (
                          <a
                            href={href}
                            target={external ? "_blank" : undefined}
                            rel={external ? "noopener noreferrer" : undefined}
                            class="inline-block transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                          >
                            {link.label}
                          </a>
                        ) : (
                          <span class="inline-block text-white/60">
                            {link.label}
                          </span>
                        )}
                      </li>
                    );
                  })}


                </ul>

              </nav>
            );

          })}

        </div>
      )}

    </div>

  </div>

  <!-- Copyright and Legal Links -->
  {(settings?.copyrightText || legalLinks.length > 0) && (
    <div class="border-t border-white/10">

      <div class="container flex flex-col gap-4 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">

        {settings?.copyrightText && (
          <p>{settings.copyrightText}</p>
        )}

        {legalLinks.length > 0 && (
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">

            {legalLinks.map((link: any) => {

              const href = getInternalUrl(link.internalLink);

              if (!href) return null;

              return (
                <li>
                  <a
                    href={href}
                    class="transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              );

            })}

          </ul>
        )}

      </div>

    </div>
  )}

</footer>
