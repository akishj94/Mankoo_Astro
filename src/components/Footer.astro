---
import SanityLink from "../components/SanityLinks.astro";

interface Props {
  settings?: any;
}

const { settings } = Astro.props;

const emails = settings?.email ?? [];
const phones = settings?.phone ?? [];
const columns = settings?.footerNavigation ?? [];

const socialLinks = settings?.socialLinks ?? [];
const legalLinks = settings?.legalLinks ?? [];

const logo = settings?.footerLogoUrl || settings?.logoUrl;

const logoAlt =
  settings?.footerLogoAlt ||
  settings?.logoAlt ||
  settings?.siteName ||
  "";

// Convert existing social links into the reusable Sanity linkObject format.
const getSocialLink = (link: any) => ({
  label: link.label,
  linkType: "external" as const,
  externalUrl: link.url?.trim() || "#",
  openInNewTab: Boolean(link.url?.trim()),
});
const sortedColumns = [
  ...columns.filter((column: any) => column.menuType !== "social"),
  ...columns.filter((column: any) => column.menuType === "social"),
];
---
<footer class="text-white">
  <div class="container py-12 md:py-16">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start">

      <!-- Brand and Contact -->
      <div class="lg:w-72 lg:shrink-0">
        {logo && (
          <a
            href="/"
            class="inline-flex rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <img
              src={logo}
              alt={logoAlt}
              loading="lazy"
              class="max-w-[180px] w-auto"
            />
          </a>
        )}

        {(emails.length > 0 || phones.length > 0 || settings?.address) && (
          <ul class="mt-6 space-y-3 text-sm lg:text-[15px] text-white/60">
            {emails.filter(Boolean).map((email: string) => (
              <li>
                <a
                  href={`mailto:${email}`}
                  class="transition-colors hover:text-accent"
                >
                  {email}
                </a>
              </li>
            ))}

            {settings?.address && (
              <li>
                {settings.address}
              </li>
            )}

            {phones.filter(Boolean).map((phone: string) => (
              <li>
                <a
                  href={`tel:${phone.replace(/[^\d+]/g, "")}`}
                  class="transition-colors hover:text-accent"
                >
                  {phone}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Footer Navigation -->
      {columns.length > 0 && (
        <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:ml-auto lg:flex lg:gap-x-16">
          {sortedColumns.map((column: any) => {
            const isSocialMenu = column.menuType === "social";

            const links = isSocialMenu
              ? socialLinks
              : (column.links ?? []);

            if (!links.length) return null;

            return (
              <nav
                aria-label={column.title}
                class="lg:w-40"
              >
                <h2 class="text-xs uppercase tracking-[0.18em] text-white/40">
                  {column.title}
                </h2>

                <ul class="mt-6 space-y-2 text-sm">
                  {links.map((link: any) => {
                      const sanityLink = isSocialMenu
                        ? getSocialLink(link)
                        : link.link;

                      if (!sanityLink?.label) return null;

                      return (
                        <li>
                          <SanityLink
                            link={sanityLink}
                            class="inline-block transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                          >
                            {sanityLink.label}
                          </SanityLink>
                        </li>
                      );
                    })}
                </ul>
              </nav>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Copyright and Legal Links -->
  {(settings?.copyrightText || legalLinks.length > 0) && (
    <div class="border-t border-white/10">
      <div class="container flex flex-col gap-4 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
        {settings?.copyrightText && (
          <p>{settings.copyrightText}</p>
        )}

        {legalLinks.length > 0 && (
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
            {legalLinks.map((item: any) => (
              item.link?.label && (
                <li>
                  <SanityLink
                    link={item.link}
                    class="transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                  >
                    {item.link.label}
                  </SanityLink>
                </li>
              )
            ))}
          </ul>
        )}
      </div>
    </div>
  )}
</footer>
