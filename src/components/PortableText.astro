---
// AI-generated: Portable Text renderer for Sanity block content.
/*
 * Handles block-level text (strong, em, code, underline, strikethrough, links)
 * and embedded images. Kept dependency-free to match the project's current stack.
 */
interface Props {
  blocks?: Array<
    | {
        _type: "block";
        _key: string;
        style?: string;
        level?: number;
        children?: Array<{
          _key: string;
          text: string;
          marks: string[];
        }>;
        markDefs?: Array<{
          _key: string;
          _type: string;
          href?: string;
          reference?: { slug?: { current?: string } };
        }>;
      }
    | {
        _type: "image";
        _key: string;
        asset?: { url?: string };
        alt?: string;
      }
  >;
}

const { blocks = [] } = Astro.props;

const linkForMarkDef = (markDef) => {
  if (markDef._type === "link") return markDef.href || "#";
  if (markDef._type === "internalLink") {
    const slug = markDef.reference?.slug?.current;
    return slug ? `/${slug}` : "#";
  }
  return "#";
};

const blockClasses = (isHeading: boolean) =>
  isHeading
    ? "mb-6 text-ink font-semibold"
    : "mb-4 text-ink/90 leading-relaxed text-[15px] md:text-[16px]";
---

{blocks.map((block) => {
  if (block._type === "block") {
    const children = (block.children ?? []).map((child) => {
      let node = <span>{child.text}</span>;
      for (const mark of child.marks ?? []) {
        const def = block.markDefs?.find((d) => d._key === mark);
        const wrap = (el) => {
          if (def?._type === "link" || def?._type === "internalLink") {
            return <a href={linkForMarkDef(def)}>{el}</a>;
          }
          if (mark === "strong") return <strong>{el}</strong>;
          if (mark === "em") return <em>{el}</em>;
          if (mark === "code") return <code>{el}</code>;
          if (mark === "underline") return <u>{el}</u>;
          if (mark === "strike-through")
            return (
              <span style={{ textDecoration: "line-through" }}>{el}</span>
            );
          return el;
        };
        node = wrap(node);
      }
      return node;
    });
    const isHeading = block.style?.startsWith("h") ?? false;
    const cls = blockClasses(isHeading);

    if (block.style === "h1") return <h1 class={cls}>{children}</h1>;
    if (block.style === "h2") return <h2 class={cls}>{children}</h2>;
    if (block.style === "h3") return <h3 class={cls}>{children}</h3>;
    if (block.style === "h4") return <h4 class={cls}>{children}</h4>;
    if (block.style === "h5") return <h5 class={cls}>{children}</h5>;
    if (block.style === "h6") return <h6 class={cls}>{children}</h6>;
    return <p class={cls}>{children}</p>;
  }

  if (block._type === "image" && block.asset?.url) {
    return (
      <img
        src={block.asset.url}
        alt={block.alt ?? ""}
        loading="lazy"
        decoding="async"
        class="mx-auto my-8 max-w-full h-auto rounded-lg border border-ink/10"
      />
    );
  }

  return null;
})}