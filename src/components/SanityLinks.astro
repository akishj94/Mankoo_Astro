---
import {
  getLinkUrl,
  type SanityLinkObject,
} from "../lib/links";

interface Props {
  link?: SanityLinkObject | null;
  class?: string;
  ariaLabel?: string;
}

const {
  link,
  class: className,
  ariaLabel,
} = Astro.props;

const href = getLinkUrl(link);

const openInNewTab = link?.openInNewTab === true;
---

{href && (
  <a
    href={href}
    class={className}
    aria-label={ariaLabel}
    target={openInNewTab ? "_blank" : undefined}
    rel={openInNewTab ? "noopener noreferrer" : undefined}
  >
    <slot>{link?.label}</slot>
  </a>
)}