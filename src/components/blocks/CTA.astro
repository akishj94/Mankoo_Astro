---
import { Image } from 'astro:assets';
import bannerImage from '../../assets/IMG_202.jpg';
---

<section
  data-cta-banner
  data-keep-dark
  class="relative isolate overflow-hidden bg-ink py-[clamp(4rem,10vw,9rem)] text-white"
>
  <Image
    src={bannerImage}
    alt="Industrial manufacturing facility"
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-10 size-full object-cover"
  />

  <div class="container">
    <div
      class="mx-auto grid w-full gap-24 rounded-[4px] bg-[#ffffff1a] ok p-6 backdrop-blur-md sm:p-6 md:max-w-[80vw] lg:grid-cols-[auto] lg:items-end lg:gap-x-32 lg:gap-y-20 lg:p-8 xl:gap-x-32"
    >
      <h2 class="leading-[1.08] tracking-tight sm:text-[36px] lg:text-[42px]">
        Let's Build Something Exceptional
      </h2>

      <div class="flex flex-col items-normal justify-between gap-6 md:flex-row md:items-end lg:gap-16">
        <p class="max-w-[48ch] text-base leading-snug text-white/60">
          Discover how our precision engineering and industrial manufacturing
          solutions can support your next project.
        </p>

        <a
          href="/contact/"
          class="inline-flex aspect-[6/3] min-w-[clamp(220px,15vw,300px)] max-w-[300px] shrink-0 flex-col justify-end gap-6 rounded-[6px] bg-[#0b3bff] px-5 pb-4 pt-[4.5rem] text-[15px] text-white transition-colors hover:bg-[#0030e0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:text-[16px]"
        >
          <span class="flex w-full items-center justify-between gap-4">
            Get in Touch
            <svg
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
              class="shrink-0"
            >
              <path
                d="M1 11 11 1M11 1H3M11 1v8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>