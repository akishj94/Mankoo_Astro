---
import type { ImageMetadata } from 'astro';
import type { SanityLinkObject } from '../../lib/links';
import SanityLink from '../SanityLinks.astro';

interface Props {
  title?: string;
  text?: string;
  link?: SanityLinkObject | null;
  ctaHref?: string;
  ctaLabel?: string;
  openInNewTab?: boolean;
  image?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  title = '',
  text: body = '',
  link,
  ctaHref: ctaHrefProp = '',
  ctaLabel: ctaLabelProp = '',
  openInNewTab: openInNewTabProp = false,
  image,
  imageAlt = '',
} = Astro.props;

// SanityLink handles linkObject resolution.
// Legacy string props remain as a fallback.
const ctaHref = link ? undefined : ctaHrefProp;
const ctaLabel = link?.label ?? ctaLabelProp;
const openInNewTab = link
  ? link.openInNewTab === true
  : openInNewTabProp;

const hasTitle = Boolean(title?.trim());
const hasBody = Boolean(body?.trim());
const hasCta = Boolean(
  (link || ctaHref?.trim()) && ctaLabel?.trim()
);
const hasImage = Boolean(image);

const hasContent = hasTitle || hasBody || hasCta || hasImage;

const legacyLink = ctaHref
  ? {
      linkType: 'external' as const,
      externalUrl: ctaHref,
      label: ctaLabel,
      openInNewTab,
    }
  : null;

const resolvedLink = link ?? legacyLink;
---

{hasContent && (
  <section
    data-cta-banner
    data-keep-dark
    class="relative isolate overflow-hidden bg-ink py-[clamp(4rem,10vw,9rem)] text-white"
  >
    {hasImage && (
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover"
      />
    )}

    <div class="container">
      <div
        class="mx-auto grid w-full gap-24 rounded-[4px] bg-white/10 p-6 backdrop-blur-[5rem] sm:p-6 md:max-w-[80vw] lg:grid-cols-[auto] lg:items-end lg:gap-x-32 lg:gap-y-8 lg:p-8 xl:gap-x-32"
      >
        {hasTitle && (
          <h2 class="leading-[1.08] tracking-tight sm:text-[36px] lg:text-[42px] md:max-w-[calc(100%_-_clamp(220px,15vw,300px))] xl:max-w-[50%]">
            {title}
          </h2>
        )}

        {(hasBody || hasCta) && (
          <div class="flex flex-col items-normal justify-between gap-6 md:flex-row md:items-end lg:gap-16">
            {hasBody && (
              <p class="max-w-[48ch] text-base leading-snug text-white/60">
                {body}
              </p>
            )}

            {hasCta && resolvedLink && (
              <SanityLink
                link={resolvedLink}
                class="inline-flex aspect-[6/3] min-w-[clamp(220px,15vw,300px)] max-w-[300px] shrink-0 flex-col justify-end gap-6 rounded-[6px] bg-[#0b3bff] px-5 pb-4 pt-[4.5rem] text-[15px] text-white transition-colors hover:bg-[#0030e0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:text-[16px]"
              >
                <span class="flex w-full items-center justify-between gap-4">
                  {ctaLabel}

                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                    class="shrink-0"
                  >
                    <path
                      d="M1 11 11 1M11 1H3M11 1v8"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </SanityLink>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}