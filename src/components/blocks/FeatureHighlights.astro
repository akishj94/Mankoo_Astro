---
const { section } = Astro.props;

const heading =
  section?.heading || "Why manufacturers choose Mankoo Power Presses";

const items = Array.isArray(section?.items)
  ? section.items
      .filter((item) => item?.title?.trim())
      .slice(0, 4)
  : [];

const itemCount = items.length;
---

{itemCount > 0 && (
  <section class="bg-white text-neutral-900">
    <div class="container py-24">

      <h2
        class="mt-4 text-[clamp(30px,4vw,56.5px)] leading-[1.08] tracking-tight"
        data-reveal
      >
        {heading}
      </h2>

      <div
        class="mt-16 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[repeat(var(--item-count),minmax(0,1fr))]"
        style={`--item-count: ${itemCount}`}
      >
        {items.map((item, index) => (
          <div
            class="border-t-2 border-[#CACACA] pt-5"
            data-reveal
          >
            <span class="text-sm text-orange-500">
              {String(index + 1).padStart(2, "0")}
            </span>

            <p class="mt-3 text-[20px] leading-snug lg:max-w-[80%]">
              {item.title}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
