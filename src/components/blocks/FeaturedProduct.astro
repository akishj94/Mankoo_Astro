---
import SanityLink from "../SanityLinks.astro";

const {
  eyebrow = "FEATURED PRODUCT",
  heading,
  description,
  backgroundImage,
  specifications = [],
  cta,
} = Astro.props;

const imageUrl = backgroundImage?.asset?.url ?? null; 
const imageAlt = backgroundImage?.alt || heading || "Featured product";

const validSpecifications = Array.isArray(specifications)
  ? specifications.filter(
      (item) => item?.label?.trim() && item?.value?.trim()
    )
  : [];

// LINK RESOLVER: cta is now { link: linkObject }
const ctaLink = cta?.link;
const validCta = Boolean(ctaLink?.label);

const ctaTarget = ctaLink?.openInNewTab ? "_blank" : undefined;
const ctaRel = ctaLink?.openInNewTab ? "noopener noreferrer" : undefined;
// PREVIOUS:
// const ctaHref =
//   cta?.linkType === "external"
//     ? cta?.url
//     : cta?.linkType === "internal" && cta?.href
//       ? `/${cta.href.replace(/^\/+|\/+$/g, "")}/`
//       : null;
// const validCta = Boolean(cta?.label && ctaHref);
// const ctaTarget = cta?.openInNewTab ? "_blank" : undefined;
// const ctaRel = cta?.openInNewTab ? "noopener noreferrer" : undefined;
---
{heading && (
  <section data-featured class="text-white">
    <div class="container pt-[clamp(48px,4vw,72px)] pb-[clamp(32px,3vw,56px)]">
      <div class="w-full min-w-0 md:max-w-[50%]" data-reveal>
        {eyebrow && (
          <p class="text-[14px] uppercase tracking-[0.2em] text-accent">
            {eyebrow}
          </p>
        )}

        <h2 class="mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]">
          {heading}
        </h2>

        {description && (
          <p class="mt-5 text-[13px] leading-[1.2] text-white/50 md:max-w-[567px] md:text-[14px] lg:text-[15px]">
            {description}
          </p>
        )}
      </div>
    </div>

    <div class="relative">
      <div class="relative isolate lg:min-h-[80vh] w-full overflow-hidden bg-neutral-900">
        {imageUrl && (
          <img
            src={imageUrl}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="position:relative lg:absolute inset-0 z-0 !size-full object-cover"
          />
        )}

        <div
          class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/25 to-black/45"
          aria-hidden="true"
        ></div>
      </div>

      <div class="relative text-white md:absolute md:inset-x-0 md:bottom-0" data-keep-dark>
        <div
          class="container pb-10 pt-10 sm:pb-8 sm:pt-12 md:pb-8 md:pt-0 lg:pb-10"
          data-reveal
        >
          <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between md:gap-12">

            {validSpecifications.length > 0 && (
              <div
                role="list"
                class="flex flex-col gap-4 md:flex-row md:items-center md:gap-4"
              >
                {validSpecifications.map((specification, index) => (
                  <>
                    <div
                      role="listitem"
                      class="flex items-baseline justify-between gap-6 border-b border-white/15 pb-4 md:justify-start md:gap-3 md:border-b-0 md:pb-0"
                    >
                      <span class="text-xs uppercase tracking-[0.1em] text-white/60">
                        {specification.label}
                      </span>

                      <span class="text-xs uppercase tracking-[0.1em] text-white">
                        {specification.value}
                      </span>
                    </div>

                    {index < validSpecifications.length - 1 && (
                      <span
                        aria-hidden="true"
                        class="hidden text-white/40 md:block"
                      >
                        |
                      </span>
                    )}
                  </>
                ))}
              </div>
            )}

            {validCta && (
              <SanityLink
                link={ctaLink}
                class="inline-flex aspect-[6/3] max-h-[140px] min-w-[clamp(220px,15vw,300px)] max-w-[300px] items-end justify-between gap-10 rounded-[10px] bg-[rgba(246,246,246,0.2)] px-4 py-4 text-[15px] leading-[1.2] text-white backdrop-blur-[5px] transition-all duration-250 hover:bg-[rgba(246,246,246,0.35)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:hover:bg-[rgba(246,246,246,0.35)] lg:text-[16px] light:bg-ink light:hover:bg-ink/85 light:focus-visible:outline-ink light:md:bg-ink light:md:hover:bg-ink/85"
              >
                <span class="inline-flex max-w-[140px] lg:max-w-[160px]">
                  {ctaLink.label}
                </span>

                <svg
                  width="15"
                  height="24"
                  class="h-4 w-[15px] shrink-0"
                  viewBox="0 -960 960 960"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
                </svg>
              </SanityLink>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
)}