---
const {
  eyebrow,
  heading,
  interval = 6,
  slides = [],
} = Astro.props.section || {};

// Ignore completely empty slides.
const validSlides = Array.isArray(slides)
  ? slides.filter((slide) => {
      return Boolean(
        slide?.image?.url ||
        slide?.title?.trim() ||
        slide?.description?.trim()
      );
    })
  : [];

// Do not render an empty section.
const hasContent = Boolean(
  eyebrow?.trim() ||
  heading?.trim() ||
  validSlides.length
);

const transitionInterval =
  Number.isFinite(Number(interval))
    ? Math.min(30, Math.max(2, Number(interval)))
    : 6;
---

{hasContent && (
  <section
    data-image-transition
    data-interval={transitionInterval}
    class="pt-12 pb-[clamp(76px,5vw,100px)] text-white light:text-ink lg:pt-20"
    aria-label={heading || eyebrow || "Image showcase"}
  >
    <div class="container">
      {(eyebrow || heading) && (
        <div data-reveal>
          {eyebrow && (
            <p class="text-[12px] uppercase tracking-[0.2em] text-accent">
              {eyebrow}
            </p>
          )}

          {heading && (
            <h2 class="mt-2 lg:mt-4 text-[clamp(26px,2.5vw,36px)] leading-[1.2] tracking-tight md:max-w-[50%]">
              {heading}
            </h2>
          )}
        </div>
      )}

      {validSlides.length > 0 && (
        <div class="mt-10 lg:mt-12" data-reveal>
          <div
            data-transition-media
            class="relative aspect-[1122/475] w-full overflow-hidden bg-ink"
            role="region"
            aria-label="Featured images"
            aria-roledescription="carousel"
          >
            {validSlides.map((slide, index) => (
              <div
                id={`transition-panel-${slide._key || index}`}
                role="tabpanel"
                aria-labelledby={`transition-tab-${slide._key || index}`}
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${validSlides.length}`}
                aria-hidden={index !== 0 ? "true" : undefined}
                data-transition-image
                class:list={[
                  "absolute inset-0",
                  index === 0 && "is-active",
                ]}
              >
                {slide.image?.url && (
                  <img
                    src={slide.image.url}
                    alt={slide.imageAlt || ""}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={index === 0 ? "high" : "auto"}
                    class="!size-full object-cover"
                  />
                )}
              </div>
            ))}
          </div>

          {validSlides.length > 1 && (
            <div
              data-transition-tabs
              role="tablist"
              aria-label="Choose a featured image"
              aria-orientation="horizontal"
              class="mt-10 grid grid-cols-1 gap-x-[6%] gap-y-8 sm:mt-12 sm:grid-cols-2"
            >
              {validSlides.map((slide, index) => (
                <button
                  type="button"
                  id={`transition-tab-${slide._key || index}`}
                  data-transition-tab
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={`transition-panel-${slide._key || index}`}
                  tabindex={index === 0 ? 0 : -1}
                  class="group block w-full cursor-pointer text-left focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-white light:focus-visible:outline-ink"
                >
                  {slide.title && (
                    <span class="block text-[18px] leading-snug transition-colors group-hover:text-white/80 light:group-hover:text-ink/70">
                      {slide.title}
                    </span>
                  )}

                  {slide.description && (
                    <span class="mt-3 block max-w-[46ch] text-[13px] leading-[1.45] text-white/50 light:text-ink/60 md:text-[14px] lg:text-[15px]">
                      {slide.description}
                    </span>
                  )}

                  <span
                    aria-hidden="true"
                    class="relative mt-8 block h-px w-full bg-white/25 light:bg-ink/15"
                  >
                    <span
                      data-transition-fill
                      class="absolute top-[-1px] left-0 block h-[3px] w-full origin-left scale-x-0 bg-accent"
                    ></span>
                  </span>
                </button>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </section>
)}

<style>
  [data-transition-media] [data-transition-image] {
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: none;
  }

  [data-transition-media] [data-transition-image].is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }
</style>


<script>
  import { gsap } from 'gsap';

  const FADE = 1.2;

  document.querySelectorAll<HTMLElement>('[data-image-transition]').forEach((section) => {
    const media = section.querySelector<HTMLElement>('[data-transition-media]');

    if (!media) return;

    const images = Array.from(
      media.querySelectorAll<HTMLElement>('[data-transition-image]')
    );

    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>('[data-transition-tab]')
    );

    const fills = Array.from(
      section.querySelectorAll<HTMLElement>('[data-transition-fill]')
    );

    const count = images.length;

    if (count === 0) return;

    // A single image does not need carousel initialization.
    if (count === 1) {
      gsap.set(images[0], { opacity: 1 });
      images[0].classList.add('is-active');
      return;
    }

    // Validate dynamic slide markup.
    if (count !== tabs.length || count !== fills.length) return;

    const parsedInterval = Number(section.dataset.interval);
    const duration = Number.isFinite(parsedInterval)
      ? Math.min(30, Math.max(2, parsedInterval))
      : 6;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let index = 0;
    let inView = false;
    let destroyed = false;

    let fillTween: gsap.core.Tween | null = null;
    let transitionTween: gsap.core.Tween | null = null;

    function markActive(next: number) {
      index = next;

      images.forEach((image, i) => {
        const active = i === next;

        image.classList.toggle('is-active', active);
        image.setAttribute('aria-hidden', String(!active));
      });

      tabs.forEach((tab, i) => {
        const active = i === next;

        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
    }

    function crossfadeTo(next: number) {
      transitionTween?.kill();

      const incoming = images[next];

      const outgoing = images.filter(
        (image, i) =>
          i !== next &&
          Number(gsap.getProperty(image, 'opacity')) > 0
      );

      // Keep the incoming image above the outgoing image.
      gsap.set(incoming, {
        zIndex: 2,
        pointerEvents: 'auto',
      });

      outgoing.forEach((image) => {
        gsap.set(image, {
          zIndex: 1,
          pointerEvents: 'none',
        });
      });

      images.forEach((image, i) => {
        if (i !== next && !outgoing.includes(image)) {
          gsap.set(image, { opacity: 0 });
        }
      });

      const animate = () => {
        if (destroyed || index !== next) return;

        transitionTween = gsap.to(incoming, {
          opacity: 1,
          duration: reducedMotion.matches ? 0 : FADE,
          ease: 'power1.inOut',
          overwrite: true,
          onComplete: () => {
            gsap.set(outgoing, {
              opacity: 0,
              zIndex: 0,
            });
          },
        });
      };

      const image = incoming.querySelector('img');

      if (image && !image.complete) {
        image.decode().then(animate).catch(animate);
      } else {
        animate();
      }
    }

    function runFill() {
      fillTween?.kill();

      gsap.set(fills, { scaleX: 0 });

      if (!inView || document.hidden || reducedMotion.matches) {
        return;
      }

      fillTween = gsap.to(fills[index], {
        scaleX: 1,
        duration,
        ease: 'none',
        onComplete: () => {
          if (!destroyed) go(index + 1);
        },
      });
    }

    function go(next: number) {
      if (destroyed) return;

      const target = (next + count) % count;

      if (target === index) {
        runFill();
        return;
      }

      markActive(target);
      crossfadeTo(target);
      runFill();
    }

    function syncPlayback() {
      if (destroyed) return;

      if (inView && !document.hidden) {
        runFill();
      } else {
        fillTween?.kill();
        fillTween = null;
        gsap.set(fills, { scaleX: 0 });
      }
    }

    // Tab interactions.
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => go(i));

      tab.addEventListener('keydown', (event) => {
        const targets: Record<string, number> = {
          ArrowRight: (i + 1) % count,
          ArrowLeft: (i - 1 + count) % count,
          Home: 0,
          End: count - 1,
        };

        const target = targets[event.key];

        if (target === undefined) return;

        event.preventDefault();

        go(target);
        tabs[target].focus();
      });
    });

    // Pause autoplay when the section leaves the viewport.
    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        syncPlayback();
      },
      { threshold: 0.25 }
    );

    observer.observe(section);

    document.addEventListener('visibilitychange', syncPlayback);

    // React to changes in the user's motion preference.
    const handleMotionChange = () => {
      if (reducedMotion.matches) {
        fillTween?.kill();
        transitionTween?.kill();

        gsap.set(images, { opacity: 0 });
        gsap.set(images[index], { opacity: 1 });
        gsap.set(fills, { scaleX: 0 });
      }

      syncPlayback();
    };

    reducedMotion.addEventListener('change', handleMotionChange);

    // Initial state.
    markActive(0);

    gsap.set(images, {
      opacity: 0,
      zIndex: 0,
    });

    gsap.set(images[0], {
      opacity: 1,
      zIndex: 2,
      pointerEvents: 'auto',
    });

    gsap.set(fills, { scaleX: 0 });

    // Cleanup for dynamically removed Astro components.
    const cleanup = () => {
      destroyed = true;

      fillTween?.kill();
      transitionTween?.kill();

      observer.disconnect();

      document.removeEventListener('visibilitychange', syncPlayback);
      reducedMotion.removeEventListener('change', handleMotionChange);

      gsap.killTweensOf(images);
      gsap.killTweensOf(fills);
    };

    section.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
