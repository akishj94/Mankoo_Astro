---
import { Image } from 'astro:assets';
---

<section data-news class="pb-[clamp(76px,5vw,100px)] text-white light:text-ink">
  <div class="container pt-[clamp(48px,4vw,72px)]">
    <div class="flex items-end justify-between gap-8" data-reveal>
      <div class="w-full min-w-0 md:max-w-[60%]">
        <h2 class="text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]">
          News & Stories
        </h2>
      </div>

      <a
        href="/news"
        class="inline-flex shrink-0 items-center gap-2 transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink/70 light:focus-visible:outline-ink"
      >
        View all
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
      <a
        href="/news/first-post"
        class="group/post block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:focus-visible:outline-ink"
      >
        <div class="relative aspect-[408.32/237.34] w-full overflow-hidden bg-[radial-gradient(101.56%_101.56%_at_87.18%_7.03%,_#002888_8.85%,_#000A22_100%)]">
          <!-- <Image
            src={post1}
            alt="First post"
            widths={[408, 640, 816, 1200]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/post:scale-110 group-focus-visible/post:scale-110"
          /> -->
        </div>
        <p class="mt-6 text-[11px] uppercase tracking-[0.2em] text-white/50 light:text-ink/60">
          Category · 5 min read
        </p>
        <h3 class="mt-4 text-[18px] leading-[1.3] tracking-tight text-white light:text-ink">
          A Comprehensive Upto 100 Ton Mechanical Press Price Guide for Industrial Manufacturers
        </h3>
      </a>

      <a
        href="/news/second-post"
        class="group/post block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:focus-visible:outline-ink"
      >
        <div class="relative aspect-[408.32/237.34] w-full overflow-hidden bg-[radial-gradient(101.56%_101.56%_at_87.18%_7.03%,_#002888_8.85%,_#000A22_100%)]">
          <!-- <Image
            src={post2}
            alt="Second post"
            widths={[408, 640, 816, 1200]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/post:scale-110 group-focus-visible/post:scale-110"
          /> -->
        </div>
        <p class="mt-6 text-[11px] uppercase tracking-[0.2em] text-white/50 light:text-ink/60">
          Category · 5 min read
        </p>
        <h3 class="mt-4 text-[18px] leading-[1.3] tracking-tight text-white light:text-ink">
          Understanding the 100 Ton Mechanical Press Price
        </h3>
      </a>

      <a
        href="/news/third-post"
        class="group/post block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:focus-visible:outline-ink"
      >
        <div class="relative aspect-[408.32/237.34] w-full overflow-hidden bg-[radial-gradient(101.56%_101.56%_at_87.18%_7.03%,_#002888_8.85%,_#000A22_100%)]">
          <!-- <Image
            src={post3}
            alt="Third post"
            widths={[408, 640, 816, 1200]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/post:scale-110 group-focus-visible/post:scale-110"
          /> -->
        </div>
        <p class="mt-6 text-[11px] uppercase tracking-[0.2em] text-white/50 light:text-ink/60">
          Category · 5 min read
        </p>
        <h3 class="mt-4 text-[18px] leading-[1.3] tracking-tight text-white light:text-ink">
          100 Ton H Type Power Press Machine
        </h3>
      </a>
    </div>
  </div>
</section>