---
const { section } = Astro.props;
const posts = section?.posts ?? [];

---

<section data-news class="pb-[clamp(76px,5vw,100px)] text-white light:text-ink">
  <div class="container pt-[clamp(48px,4vw,72px)]">
    <div class="flex items-end justify-between gap-8" data-reveal>
      <div class="w-full min-w-0 md:max-w-[60%]">
        <h2 class="text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]">
          {section.title}
        </h2>
      </div>

      <a
        href="/blog"
        class="inline-flex shrink-0 items-center gap-2 transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink/70 light:focus-visible:outline-ink"
      >
        View all
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group/post block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:focus-visible:outline-ink"
        >
          <div class="relative aspect-[408.32/237.34] w-full overflow-hidden bg-[radial-gradient(101.56%_101.56%_at_87.18%_7.03%,_#002888_8.85%,_#000A22_100%)]">
            {post.image?.asset?.url && (
              <img
                src={post.image.asset.url}
                alt={post.image.alt || post.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover/post:scale-105"
                loading="lazy"
              />
            )}
          </div>

          <p class="mt-6 text-[11px] uppercase tracking-[0.2em] text-white/50 light:text-ink/60 flex items-center gap-x-2">
              {post.publishedAt && !isNaN(new Date(post.publishedAt).getTime()) && (
                <>
                  <time datetime={new Date(post.publishedAt).toISOString()}>
                    {new Date(post.publishedAt).toLocaleDateString('en-GB', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric'
                    })}
                  </time>
                  {' · '}
                </>
              )}
                <span class="inline-flex items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="clock-icon"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"></polyline></svg>
                {Math.ceil((post.excerpt?.split(' ')?.length || 0) / 200)} min read
                </span>
              
            </p>

          <h3 class="mt-4 text-[18px] leading-[1.3] tracking-tight text-white light:text-ink">
            {post.title}
          </h3>
        </a>
      ))}
    </div>
  </div>
</section>