---
interface Props {
  introText?: string;
  highlightText?: string;
  pillars: Array<{
    _key: string;
    heading: string;
    copy: string;
    image: {
      alt: string;
      url: string;
      dimensions: { width: number; height: number };
      lqip: string;
    } | null;
  }>;
}

const {
  introText = '',
  highlightText = '',
  pillars = [],
} = Astro.props;
---

{introText || highlightText || pillars.length > 0 ? (
  <section class="py-12 lg:py-24">
    <div class="container">
      {introText && (
        <div class="mb-4 max-w-3xl mb:6 md:mb-12">
          <h2 class="text-[clamp(26px,2.5vw,36px)] leading-[1.2] tracking-tight">
            {introText}
            {highlightText && (
              <>
                <span class="block text-white/60">
                  {highlightText}
                </span>
              </>
            )}
          </h2>
        </div>
      )}
      {pillars.length > 0 && (
  <div
    class="
      grid grid-flow-col auto-cols-[85%]
      gap-4
      overflow-x-auto
      snap-x snap-mandatory
      overscroll-x-contain
      no-scrollbar
      pb-2
      sm:auto-cols-[60%]
      lg:grid-flow-row
      lg:grid-cols-3
      lg:auto-cols-auto
      lg:gap-6
      lg:overflow-visible
      lg:snap-none
      lg:pb-0
    "
  >
    {pillars.map((pillar) => (
      <article
        class="
          relative
          overflow-hidden
          bg-neutral-900
          aspect-[1/1]
          snap-start
        "
      >
        {pillar.image?.url && (
          <img
            src={pillar.image.url}
            alt={pillar.image.alt || pillar.heading || ''}
            width={pillar.image.dimensions?.width || 800}
            height={pillar.image.dimensions?.height || 600}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 !size-full object-cover object-center"
          />
        )}

        <div
          class="absolute inset-0 bg-black/40"
          aria-hidden="true"
        />

        <div class="absolute left-6 right-6 top-6 z-10">
          <h3 class="text-2xl leading-snug tracking-tight text-white">
            {pillar.heading}
          </h3>
        </div>

        <div class="absolute bottom-6 left-6 right-6 z-10">
          <p class="leading-tight text-white/90 md:max-w-[85%] xl:max-w-[65%]">
            {pillar.copy}
          </p>
        </div>
      </article>
    ))}
  </div>
)}
      
    </div>
  </section>
) : null}
