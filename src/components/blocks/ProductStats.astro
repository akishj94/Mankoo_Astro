---
// Generated by AI
interface ProductStatsProps {
  label?: string;
  heading?: string;
  copy?: string;
  image?: {
    alt?: string;
    url?: string;
    dimensions?: { width: number; height: number };
    lqip?: string;
  } | null;
}

interface KeyNumber {
  _key: string;
  label: string;
  value: string;
}

interface Props {
  productStats?: ProductStatsProps | null;
  keyNumbers?: KeyNumber[];
}

const {
  productStats = null,
  keyNumbers = [],
} = Astro.props;

const hasContent = Boolean(
  productStats?.heading ||
    productStats?.copy ||
    productStats?.image?.url ||
    keyNumbers.length > 0
);
// /Generated by AI
---

{hasContent ? (
  <>
    <!-- Generated by AI -->
    <section class="text-white">
      <div class="container">
        {productStats && (
          <div class="grid grid-cols-1 items-end lg:grid-cols-2 gap-8 lg:gap-16 pt-16 lg:pt-24 pb-10">
            <div class="min-w-0">
              {productStats.label && (
                <p class="text-[12px] uppercase tracking-[0.2em] text-accent">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true" />
                  {productStats.label}
                </p>
              )}
              {productStats.heading && (
                <h2 class="md:max-w-[70%] xl:max-w-[70%] leading-[1.08] tracking-tight text-[clamp(30px,3.6vw,50.5px)] mt-6">
                  {productStats.heading}
                </h2>
              )}
            </div>
            {productStats.copy && (
              <div class="min-w-0">
                <p class="text-pretty sm:text-[15px] md:text-[16px] leading-[1.45] text-white/60 lg:max-w-[80ch]">
                  {productStats.copy}
                </p>
              </div>
            )}
          </div>
        )}

        {productStats?.image?.url && (
          <figure class="relative overflow-hidden">
            <img
              src={productStats.image.url}
              alt={productStats.image.alt || productStats.heading || 'Product'}
              width={productStats.image.dimensions?.width || 800}
              height={productStats.image.dimensions?.height || 600}
              loading="lazy"
              decoding="async"
              class="w-full h-auto block mx-auto"
            />
          </figure>
        )}

        {keyNumbers.length > 0 && (
          <div class="py-10 lg:pt-12 lg:pb-16">
            <div class="grid grid-cols-2 gap-x-10 gap-y-10 lg:grid-cols-4 lg:gap-x-16">
              {keyNumbers.map((number) => (
                <div class="border-t-2 border-[#242B3C]">
                  <p class="text-[clamp(11px,0.7vw,14px)] uppercase tracking-[0.1em] text-white/60 mt-4 mb-4">
                    {number.label}
                  </p>
                  <p class="text-[clamp(20px,4vw,24px)] font-normal leading-none tracking-tight text-white">
                    {number.value}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
    <!-- /Generated by AI -->
  </>
) : null}
