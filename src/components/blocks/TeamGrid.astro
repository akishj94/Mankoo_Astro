---
import SanityLink from "../SanityLinks.astro";

interface TeamMember {
  _key?: string;
  name?: string;
  role?: string;
  linkedinUrl?: string | null;
  image?: {
    alt?: string;
    url?: string;
  } | null;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  members?: TeamMember[] | null;
  cta?: any;
}

const {
  eyebrow,
  heading,
  members = [],
  cta,
} = Astro.props;

const validMembers = (members ?? []).filter(
  (member) => member?.name?.trim()
);

const validCta = Boolean(cta?.label);
---

{heading && (
  <section class="text-white light:text-ink">
    <div class="container py-16 md:py-24">
      <div class="w-full min-w-0 md:max-w-[clamp(60%,80vw,940px)]">
        {eyebrow && (
          <p
            class="text-[14px] uppercase tracking-[0.2em] text-accent"
            data-reveal
          >
            {eyebrow}
          </p>
        )}

        <h2
          class="mt-2 lg:mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]"
          data-reveal
        >
          {heading}
        </h2>
      </div>

      {validMembers.length > 0 && (
        <div class="mt-10 grid grid-cols-2 gap-x-3 gap-y-12 lg:grid-cols-4">
          {validMembers.map((member) => (
            <article data-reveal>
              {member.image?.url ? (
                <img
                  src={member.image.url}
                  alt={member.image.alt || member.name || ""}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full bg-neutral-900 object-cover"
                />
              ) : (
                <div
                  class="aspect-[4/5] w-full bg-neutral-900"
                  aria-hidden="true"
                ></div>
              )}

              <h3 class="mt-8 text-[16px] leading-snug">
                {member.name}
              </h3>

              {member.role && (
                <p class="mt-1 text-[16px] leading-snug text-white/60 light:text-ink/60">
                  {member.role}
                </p>
              )}

              {member.linkedinUrl && (
                <a
                  href={member.linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-8 inline-flex items-center gap-1 text-[16px] text-white transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white light:text-ink light:focus-visible:outline-ink"
                >
                  LinkedIn

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="16px"
                    viewBox="0 -960 960 960"
                    width="16px"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z" />
                  </svg>
                </a>
              )}
            </article>
          ))}
        </div>
      )}

      {validCta && (
        <SanityLink
          link={cta}
          class="flex aspect-[6/3] min-w-[clamp(220px,15vw,300px)] max-w-[300px] items-end justify-between gap-10 rounded-[10px] backdrop-blur-[5rem] bg-white/10 px-4 py-4 text-[15px] leading-[1.2] text-white transition-all duration-250 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:text-[16px] md:hover:bg-[rgba(246,246,246,0.25)] light:bg-ink light:hover:bg-ink/85 light:focus-visible:outline-ink light:md:bg-ink light:md:hover:bg-ink/85 mt-30"
          data-reveal
        >
          <span> {cta.label} </span>

          <svg
            width="15"
            height="24"
            class="h-4 w-[15px] shrink-0"
            viewBox="0 -960 960 960"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
          </svg>
        </SanityLink>
      )}
    </div>
  </section>
)}
