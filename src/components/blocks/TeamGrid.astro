---
import { Image } from 'astro:assets';
---

<section class="text-white light:text-ink">
  <div class="container py-16 md:py-24">
    <div class="w-full min-w-0 md:max-w-[clamp(60%,80vw,940px)]">
      <p
        class="text-[14px] uppercase tracking-[0.2em] text-accent"
        data-reveal
      >
        Meet the leadership team
      </p>

      <h2
        class="mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]"
        data-reveal
      >
        The people behind the engineering.
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-x-3 gap-y-12 lg:grid-cols-4">
      <article data-reveal>
        <div class="aspect-[4/5] w-full bg-neutral-900"></div>
        <!-- <Image
          src={member1}
          alt="Member One"
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 25vw, 50vw"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full bg-neutral-900 object-cover"
        /> -->
        <h3 class="mt-8 text-[16px] leading-snug">Mohinder Singh Mankoo</h3>
        <p class="mt-1 text-[16px] leading-snug text-white/60 light:text-ink/60">Founder</p>
        <a
          href="https://www.linkedin.com/in/member-one"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-1 text-[16px] text-white transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white light:text-ink light:focus-visible:outline-ink"
        >
          LinkedIn
          <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg>
        </a>
      </article>

