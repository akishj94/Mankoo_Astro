---
import "swiper/css";

interface TimelineItem {
  _key?: string;
  year?: string;
  title?: string;
  content?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  items?: TimelineItem[] | null;
  addPlaceholderData?: boolean;
  sectionKey?: string;
}

const {
  eyebrow = "OUR JOURNEY",
  heading = "",
  items = [],
  addPlaceholderData = false,
  sectionKey = "timeline",
} = Astro.props;

// Handle missing, null, non-array and empty milestone data.
const sourceItems = Array.isArray(items) ? items : [];

// Only accept complete milestones.
const validItems = sourceItems.filter(
  (item) =>
    item &&
    typeof item.year === "string" &&
    item.year.trim() !== "" &&
    typeof item.title === "string" &&
    item.title.trim() !== "" &&
    typeof item.content === "string" &&
    item.content.trim() !== ""
);

// Do not render if no valid milestone exists.
const hasMilestones = validItems.length > 0;

// Generate 18 slides only when placeholder mode is enabled.
const slides = !hasMilestones
  ? []
  : addPlaceholderData
    ? Array.from({ length: 18 }, (_, index) => ({
        ...validItems[index % validItems.length],
        slideKey: `${validItems[index % validItems.length]._key ?? "milestone"}-${index}`,
      }))
    : validItems.map((item, index) => ({
        ...item,
        slideKey: item._key ?? String(index),
      }));

const safeSectionKey = String(sectionKey).replace(
  /[^a-zA-Z0-9_-]/g,
  ""
);

const headingId = `timeline-heading-${safeSectionKey}`;
---

{slides.length > 0 && (
  <section
    data-timeline
    aria-labelledby={heading ? headingId : undefined}
    class="overflow-hidden text-white light:text-ink"
  >
    <div class="container pt-8 md:pt-12 pb-24 md:pb-32">
      <div class="w-full min-w-0 md:max-w-[clamp(60%,80vw,940px)]">
        {eyebrow && (
          <p
            class="text-xs md:text-[13px] uppercase tracking-[0.1em] text-accent"
            data-reveal
          >
            {eyebrow}
          </p>
        )}

        {heading && (
          <h2
            id={headingId}
            class="mt-3 lg:mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]"
            data-reveal
          >
            {heading}
          </h2>
        )}
      </div>

      <div class="mt-10 sm:mt-14" data-reveal>
        <div
          class="swiper"
          data-timeline-root
          role="region"
          aria-label="Company history milestones"
          aria-roledescription="carousel"
        >
          <div class="swiper-wrapper items-stretch gap-x-5 md:gap-x-8 lg:gap-x-10">
            {slides.map((item, index) => (
              <div
                class="swiper-slide h-auto! w-full! sm:w-1/2! md:w-1/3! lg:w-1/4!"
                role="group"
                aria-roledescription="slide"
                aria-label={`Milestone ${index + 1} of ${slides.length}: ${item.title}`}
              >
                <article class="flex h-full flex-col">
                  <p class="text-[14px] lg:text-[16px] uppercase tracking-[0.1em] text-accent">
                    {item.year}
                  </p>

                  <div
                    aria-hidden="true"
                    class="mt-3 h-px w-full bg-white/20 light:bg-ink/15"
                  />

                  <h3 class="mt-5 text-[20px] md:text-[20px] lg:text-[24px] leading-snug tracking-tight">
                    {item.title}
                  </h3>

                  <p class="mt-2 text-[14px] md:text-[15px] lg:text-[16px] leading-[1.5] text-white/60 light:text-ink/60">
                    {item.content}
                  </p>
                </article>
              </div>
            ))}
          </div>
        </div>

        <div
          class="relative mt-36 select-none cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
          data-timeline-track
          role="slider"
          tabindex="0"
          aria-label="Timeline position"
          aria-orientation="horizontal"
          aria-valuemin="1"
          aria-valuemax={slides.length}
          aria-valuenow="1"
          aria-valuetext={`Milestone 1 of ${slides.length}`}
        >
          <div
            data-timeline-ticks
            aria-hidden="true"
            class="flex h-8 items-center justify-between gap-[3px]"
          >
            {Array.from({ length: 72 }, (_, i) => {
              const isLong = i % 13 === 0 || i % 17 === 5;
              const isMedium = !isLong && i % 5 === 0;
              const isAccent =
                i % 11 === 2 ||
                i % 7 === 3 ||
                (isLong && i % 3 === 0);

              return (
                <span
                  class:list={[
                    "block shrink-0",
                    isAccent
                      ? "bg-accent"
                      : "bg-white/20 light:bg-ink/15",
                    isLong
                      ? "h-[28px] w-[2px]"
                      : isMedium
                        ? "h-[18px]"
                        : "h-[10px]",
                    isLong || isMedium ? "" : "w-[1px]",
                    "opacity-55",
                  ]}
                />
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  import Swiper from "swiper";
  import { A11y, FreeMode, Keyboard } from "swiper/modules";

  const TICK_COUNT = 72;

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  const TICK_BASE = [
    "block",
    "shrink-0",
    "rounded-full",
    "bg-white/20",
    "light:bg-ink/15",
  ];

  const TICK_ACCENT = [
    "block",
    "shrink-0",
    "rounded-full",
    "bg-accent",
  ];

  function buildTicks(track: Element) {
    const holder = track.querySelector("[data-timeline-ticks]");

    if (!holder || holder.childElementCount > 0) {
      return holder;
    }

    for (let i = 0; i < TICK_COUNT; i += 1) {
      const tick = document.createElement("span");

      const isLong = i % 13 === 0 || i % 17 === 5;
      const isMedium = !isLong && i % 5 === 0;
      const isAccent =
        i % 11 === 2 ||
        i % 7 === 3 ||
        (isLong && i % 3 === 0);

      tick.className = [
        ...(isAccent ? TICK_ACCENT : TICK_BASE),
        isLong
          ? "h-[28px]"
          : isMedium
            ? "h-[18px]"
            : "h-[10px]",
        isLong ? "w-[3px]" : "w-[2px]",
        "opacity-55",
      ].join(" ");

      holder.appendChild(tick);
    }

    return holder;
  }

  document.querySelectorAll("[data-timeline]").forEach((section) => {
    const root = section.querySelector("[data-timeline-root]");
    const track = section.querySelector("[data-timeline-track]");

    if (!root || !track) return;

    const holder = buildTicks(track);
    const ticks = holder ? Array.from(holder.children) : [];

    const paint = (progress: number) => {
      const clamped = Math.min(1, Math.max(0, progress));

      ticks.forEach((tick, index) => {
        const ratio =
          ticks.length > 1
            ? index / (ticks.length - 1)
            : 0;

        const passed = ratio <= clamped;

        tick.classList.toggle("opacity-100", passed);
        tick.classList.toggle("opacity-55", !passed);
      });
    };

    const updateTrackValue = (swiper: Swiper) => {
      const current = Math.min(
        swiper.slides.length,
        Math.max(1, swiper.activeIndex + 1)
      );

      track.setAttribute("aria-valuenow", String(current));

      track.setAttribute(
        "aria-valuetext",
        `Milestone ${current} of ${swiper.slides.length}`
      );
    };

    const swiper = new Swiper(root as HTMLElement, {
      modules: [A11y, FreeMode, Keyboard],

      slidesPerView: "auto",
      spaceBetween: 0,
      grabCursor: true,
      watchOverflow: true,

      freeMode: {
        enabled: true,
        momentumRatio: 0.7,
      },

      speed: reducedMotion.matches ? 0 : 600,

      keyboard: {
        enabled: true,
        onlyInViewport: true,
      },

      a11y: {
        prevSlideMessage: "Previous milestone",
        nextSlideMessage: "Next milestone",
        containerRoleDescriptionMessage: "timeline carousel",
      },

      on: {
        progress(s) {
          paint(s.progress);
          updateTrackValue(s);
        },

        slideChange(s) {
          updateTrackValue(s);
        },
      },
    });

    paint(swiper.progress);
    updateTrackValue(swiper);

    const moveToPosition = (clientX: number) => {
      const rect = track.getBoundingClientRect();

      if (!rect.width || swiper.slides.length <= 1) {
        return;
      }

      const ratio = Math.min(
        1,
        Math.max(0, (clientX - rect.left) / rect.width)
      );

      const target = Math.round(
        ratio * (swiper.slides.length - 1)
      );

      swiper.slideTo(
        target,
        reducedMotion.matches ? 0 : 500
      );
    };

    track.addEventListener("pointerdown", (event) => {
      moveToPosition(event.clientX);
    });

    track.addEventListener("keydown", (event) => {
      const keyEvent = event as KeyboardEvent;
      let target = swiper.activeIndex;

      switch (keyEvent.key) {
        case "ArrowRight":
        case "ArrowUp":
          target += 1;
          break;

        case "ArrowLeft":
        case "ArrowDown":
          target -= 1;
          break;

        case "Home":
          target = 0;
          break;

        case "End":
          target = swiper.slides.length - 1;
          break;

        default:
          return;
      }

      keyEvent.preventDefault();

      swiper.slideTo(
        Math.max(
          0,
          Math.min(swiper.slides.length - 1, target)
        ),
        reducedMotion.matches ? 0 : 500
      );
    });
  });
</script>