---
import 'swiper/css';
import { Image } from 'astro:assets';
import bannerImage from '../../assets/Slide04_28_59 AM 1.png';


const eyebrow = 'Our Journey';
const title = 'Milestones in Our History';

const items = [
  {
    year: '1990',
    title: 'The Beginning',
    content: 'Our journey began with a vision to deliver dependable industrial press solutions.',
  },
  {
    year: '1993',
    title: 'First Manufacturing Facility',
    content: 'Established our first manufacturing facility to serve growing industrial needs.',
  },
  {
    year: '1996',
    title: 'Expanding Capabilities',
    content: 'Expanded production capabilities and introduced new engineering processes.',
  },
  {
    year: '2000',
    title: 'A New Era',
    content: 'Invested in modern machinery to improve precision and production efficiency.',
  },
  {
    year: '2004',
    title: 'Product Development',
    content: 'Introduced new product solutions for a wider range of industrial applications.',
  },
  {
    year: '2008',
    title: 'Growing Our Reach',
    content: 'Expanded our customer network and strengthened long-term partnerships.',
  },
  {
    year: '2012',
    title: 'Technology Investment',
    content: 'Adopted advanced manufacturing technologies to support evolving requirements.',
  },
  {
    year: '2015',
    title: 'Quality Commitment',
    content: 'Further developed quality processes to ensure consistent product performance.',
  },
  {
    year: '2018',
    title: 'Facility Expansion',
    content: 'Expanded our operational capabilities to support increasing customer demand.',
  },
  {
    year: '2020',
    title: 'Innovation and Resilience',
    content: 'Focused on continuous improvement and dependable customer support.',
  },
  {
    year: '2023',
    title: 'New Opportunities',
    content: 'Continued developing solutions for modern manufacturing environments.',
  },
  {
    year: '2025',
    title: 'Looking Ahead',
    content: 'Building on decades of experience to shape the next chapter of our journey.',
  },
];
---

<section data-timeline class="overflow-hidden text-white light:text-ink">
  <div class="container">
    <Image
      src={bannerImage}
      alt="Industrial manufacturing facility"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="inset-0 -z-10 size-full object-cover"
    />
  </div>
  <div class="container pt-8 md:pt-12  pb-24 md:pb-32">
    <div class="w-full min-w-0 md:max-w-[clamp(60%,80vw,940px)]">
      <p class="text-[14px] uppercase tracking-[0.2em] text-accent" data-reveal>
        {eyebrow}
      </p>

      <h2
        class="mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]"
        data-reveal
      >
        {title}
      </h2>
    </div>

    <div class="mt-10 sm:mt-14" data-reveal>
      <div class="swiper" data-timeline-root>
        <ul class="swiper-wrapper items-stretch">
          {items.map((item) => (
            <li class="swiper-slide h-auto! px-3 w-full! sm:w-1/2! md:w-1/3! lg:w-1/4!">
              <article class="flex h-full flex-col">
                <p class="text-[14px] lg:text-[16px] uppercase tracking-[0.1em] text-accent">
                  {item.year}
                </p>

                <div
                  aria-hidden="true"
                  class="mt-3 h-px w-full bg-white/20 light:bg-ink/15"
                />

                <h3 class="mt-5 text-[20px] md:text-[20px] lg:text-[24px] leading-snug tracking-tight">
                  {item.title}
                </h3>

                <p class="mt-2 text-[14px] md:text-[15px] lg:text-[16px] leading-[1.5] text-white/60 light:text-ink/60">
                  {item.content}
                </p>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="relative mt-36 select-none"
        data-timeline-track
        role="presentation"
        aria-hidden="true"
      >
        <div data-timeline-ticks class="flex h-8 items-center justify-between gap-[3px]">
          {Array.from({ length: 72 }, (_, i) => {
            const isLong = i % 13 === 0 || i % 17 === 5;
            const isMedium = !isLong && i % 5 === 0;
            const isAccent = i % 11 === 2 || i % 7 === 3 || (isLong && i % 3 === 0);

            return (
              <span
                class:list={[
                  'block shrink-0 rounded-full',
                  isAccent ? 'bg-accent' : 'bg-white/20 light:bg-ink/15',
                  isLong ? 'h-[28px] w-[3px]' : isMedium ? 'h-[18px]' : 'h-[10px]',
                  isLong || isMedium ? '' : 'w-[2px]',
                  'opacity-55',
                ]}
              />
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
import { A11y, FreeMode, Keyboard } from 'swiper/modules';

const TICK_COUNT = 72;
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

const TICK_BASE = ['block', 'shrink-0', 'rounded-full', 'bg-white/20', 'light:bg-ink/15'];
const TICK_ACCENT = ['block', 'shrink-0', 'rounded-full', 'bg-accent'];

function buildTicks(track) {
  const holder = track.querySelector('[data-timeline-ticks]');
  if (!holder || holder.childElementCount > 0) return holder;

  for (let i = 0; i < TICK_COUNT; i += 1) {
    const tick = document.createElement('span');
    const isLong = i % 13 === 0 || i % 17 === 5;
    const isMedium = !isLong && i % 5 === 0;
    const isAccent = i % 11 === 2 || i % 7 === 3 || (isLong && i % 3 === 0);

    tick.className = [
      ...(isAccent ? TICK_ACCENT : TICK_BASE),
      isLong ? 'h-[28px]' : isMedium ? 'h-[18px]' : 'h-[10px]',
      isLong ? 'w-[3px]' : 'w-[2px]',
      'opacity-55',
    ].join(' ');

    holder.appendChild(tick);
  }

  return holder;
}

document.querySelectorAll('[data-timeline]').forEach((section) => {
  const root = section.querySelector('[data-timeline-root]');
  const track = section.querySelector('[data-timeline-track]');

  if (!root || !track) return;

  const holder = buildTicks(track);
  const ticks = holder ? Array.from(holder.children) : [];

  const paint = (progress) => {
    const clamped = Math.min(1, Math.max(0, progress));

    ticks.forEach((tick, index) => {
      const ratio = ticks.length > 1 ? index / (ticks.length - 1) : 0;
      const passed = ratio <= clamped;

      tick.classList.toggle('opacity-100', passed);
      tick.classList.toggle('opacity-55', !passed);
    });
  };

  const swiper = new Swiper(root, {
    modules: [A11y, FreeMode, Keyboard],
    slidesPerView: 'auto',
    spaceBetween: 0,
    grabCursor: true,
    watchOverflow: true,
    freeMode: { enabled: true, momentumRatio: 0.7 },
    speed: reducedMotion.matches ? 0 : 600,
    keyboard: { enabled: true, onlyInViewport: true },
    a11y: {
      prevSlideMessage: 'Previous milestone',
      nextSlideMessage: 'Next milestone',
      containerRoleDescriptionMessage: 'timeline carousel',
    },
    on: {
      progress(s) {
        paint(s.progress);
      },
    },
  });

  paint(swiper.progress);

  track.addEventListener('pointerdown', (event) => {
    const rect = track.getBoundingClientRect();
    if (!rect.width) return;

    const ratio = (event.clientX - rect.left) / rect.width;
    const target = Math.round(
      Math.min(1, Math.max(0, ratio)) * (swiper.slides.length - 1)
    );

    swiper.slideTo(target, reducedMotion.matches ? 0 : 500);
  });
});
</script>