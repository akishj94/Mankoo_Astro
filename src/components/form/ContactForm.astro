
---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="contact-form w-full"
  novalidate
>
  <!-- Web3Forms configuration -->
  <input type="hidden" name="access_key" value={accessKey} />
  <input
    type="hidden"
    name="subject"
    value="New Website Inquiry — Mankoo Presses"
  />
  <input
    type="hidden"
    name="from_name"
    value="Mankoo Presses Website"
  />

  <!-- Honeypot -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 md:gap-y-12">

    <!-- Full Name -->
    <div>
      <label for="contact-name" class="mb-2 block text-normal">
        Full Name <span aria-hidden="true" class="text-accent">*</span>
      </label>

      <input
        id="contact-name"
        name="name"
        type="text"
        placeholder="Enter your full name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
        class="contact-input placeholder:text-white/20 placeholder:tracking-[0.5px]"
      />

      <p class="field-error mt-2 hidden text-sm leading-5 text-red-400"
        data-error-for="contact-name">
        Please enter your full name.
      </p>
    </div>

    <!-- Email -->
    <div>
      <label for="contact-email" class="mb-2 block text-normal">
        Email Address <span aria-hidden="true" class="text-accent">*</span>
      </label>

      <input
        id="contact-email"
        name="email"
        type="email"
        placeholder="Enter your email address"
        autocomplete="email"
        required
        maxlength="254"
        class="contact-input placeholder:text-white/20 placeholder:tracking-[0.5px]"
      />

      <p class="field-error mt-2 hidden text-sm leading-5 text-red-400"
        data-error-for="contact-email">
        Please enter a valid email address.
      </p>
    </div>

    <!-- Phone -->
    <div>
      <label for="contact-phone" class="mb-2 block text-normal">
        Phone Number <span aria-hidden="true" class="text-accent">*</span>
      </label>

      <input
        id="contact-phone"
        name="phone"
        type="tel"
        placeholder="Enter your phone number"
        autocomplete="tel"
        required
        class="contact-input placeholder:text-white/20 placeholder:tracking-[0.5px]"
      />

      <p class="field-error mt-2 hidden text-sm leading-5 text-red-400"
        data-error-for="contact-phone">
        Please enter a valid international phone number.
      </p>
    </div>

    <!-- Inquiry Type -->
    <div>
      <label for="contact-inquiry" class="mb-2 block text-normal">
        Inquiry Type <span aria-hidden="true" class="text-accent">*</span>
      </label>

      <select
        id="contact-inquiry"
        name="inquiry_type"
        required
        class="contact-input cursor-pointer color-scheme-dark"
      >
        <option value="" disabled selected>Select an inquiry type</option>
        <option value="Buying New Machine">Buying New Machine</option>
        <option value="General Query">General Query</option>
        <option value="Customer Support">Customer Support</option>
        <option value="Contract">Contract</option>
      </select>

      <p class="field-error mt-2 hidden text-sm leading-5 text-red-400"
        data-error-for="contact-inquiry">
        Please select an inquiry type.
      </p>
    </div>

    <!-- Message -->
    <div class="md:col-span-2">
      <label for="contact-message" class="mb-2 block text-normal">
        Message <span aria-hidden="true" class="text-accent">*</span>
      </label>

      <textarea
        id="contact-message"
        name="message"
        rows="3"
        placeholder="Tell us how we can help you..."
        required
        minlength="10"
        maxlength="5000"
        class="contact-input min-h-36 resize-y placeholder:text-white/20 placeholder:tracking-[0.5px]"
      ></textarea>

      <p class="field-error mt-2 hidden text-sm leading-5 text-red-400"
        data-error-for="contact-message">
        Please enter a message of at least 10 characters.
      </p>
    </div>
  </div>

  <!-- hCaptcha and Submit -->
  <div class="mt-12 flex flex-col items-start gap-5 lg:mt-16">

    <div
      class="h-captcha"
      data-captcha="true"
      data-theme="dark"
    ></div>

    <p
      class="field-error hidden text-sm leading-5 text-red-400"
      data-captcha-error
      role="alert"
    >
      Please complete the CAPTCHA verification.
    </p>

    <button
      type="submit"
      class="inline-flex min-w-[180px] max-w-[300px] shrink-0 cursor-pointer flex-col justify-end gap-6 rounded-[6px] bg-[#0b3bff] px-5 py-4 text-[15px] text-white transition-colors hover:bg-[#0030e0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-60 lg:text-base"
    >
      <span data-button-label>Send Message</span>
    </button>
  </div>

  <!-- Submission Result -->
  <p
    class="mt-5 text-normal"
    data-contact-result
    role="status"
    aria-live="polite"
  ></p>
</form>

<!-- Web3Forms CAPTCHA script -->
<script
  is:inline
  src="https://web3forms.com/client/script.js"
  async
  defer
></script>

<script>
  import intlTelInput from "intl-tel-input";
  import "intl-tel-input/styles";

  type FormField =
    | HTMLInputElement
    | HTMLSelectElement
    | HTMLTextAreaElement;

  function initialiseContactForms() {
    document.querySelectorAll<HTMLFormElement>(".contact-form")
      .forEach((form) => {
        if (form.dataset.initialized === "true") return;

        const phoneInput =
          form.querySelector<HTMLInputElement>("#contact-phone");

        const submitButton =
          form.querySelector<HTMLButtonElement>('button[type="submit"]');

        const result =
          form.querySelector<HTMLParagraphElement>("[data-contact-result]");

        const buttonLabel =
          form.querySelector<HTMLElement>("[data-button-label]");

        const captchaError =
          form.querySelector<HTMLElement>("[data-captcha-error]");

        if (!phoneInput || !submitButton || !result ||
            !buttonLabel || !captchaError) return;

        form.dataset.initialized = "true";

        const iti = intlTelInput(phoneInput, {
          initialCountry: "in",
          preferredCountries: ["in", "us", "gb", "ae", "de"],
          separateDialCode: true,
          nationalMode: true,
          strictMode: true,
          loadUtils: () => import("intl-tel-input/utils"),
        });

        const fields = Array.from(
          form.querySelectorAll<FormField>(
            "input[required], select[required], textarea[required]"
          )
        ).filter((field) => field.name !== "botcheck");

        let isSubmitting = false;

        function showResult(
          message: string,
          type: "success" | "error"
        ) {
          result.textContent = message;
          result.classList.remove("text-red-400", "text-green-400");
          result.classList.add(
            type === "success" ? "text-green-400" : "text-red-400"
          );
        }

        function clearResult() {
          result.textContent = "";
          result.classList.remove("text-red-400", "text-green-400");
        }

        function setFieldError(field: HTMLElement, message: string) {
          const error = form.querySelector<HTMLElement>(
            `[data-error-for="${field.id}"]`
          );

          field.setAttribute("aria-invalid", "true");

          if (error) {
            error.textContent = message;
            error.classList.remove("hidden");
          }
        }

        function clearFieldError(field: HTMLElement) {
          const error = form.querySelector<HTMLElement>(
            `[data-error-for="${field.id}"]`
          );

          field.removeAttribute("aria-invalid");
          error?.classList.add("hidden");
        }

        function validateField(field: FormField): boolean {
          clearFieldError(field);

          if (field === phoneInput) {
            if (!phoneInput.value.trim()) {
              setFieldError(phoneInput, "Please enter your phone number.");
              return false;
            }

            if (!iti.isValidNumber()) {
              setFieldError(
                phoneInput,
                "Please enter a valid international phone number."
              );
              return false;
            }

            return true;
          }

          if (!field.checkValidity()) {
            let message = "Please check this field.";

            if (field instanceof HTMLInputElement && field.type === "email") {
              message = "Please enter a valid email address.";
            } else if (field instanceof HTMLTextAreaElement) {
              message = "Please enter a message of at least 10 characters.";
            } else if (field instanceof HTMLSelectElement) {
              message = "Please select an inquiry type.";
            } else if (field instanceof HTMLInputElement && field.type === "text") {
              message = "Please enter your full name.";
            }

            setFieldError(field, message);
            return false;
          }

          return true;
        }

        function showCaptchaError() {
          captchaError.classList.remove("hidden");
          form.querySelector(".h-captcha")?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
        }

        function clearCaptchaError() {
          captchaError.classList.add("hidden");
        }

        fields.forEach((field) => {
          field.addEventListener("input", () => {
            validateField(field);
            clearResult();
          });

          field.addEventListener("change", () => {
            validateField(field);
            clearResult();
          });
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (isSubmitting) return;

          isSubmitting = true;
          submitButton.disabled = true;
          buttonLabel.textContent = "Sending...";

          clearResult();
          clearCaptchaError();

          let timeout: number | undefined;

          try {
            await iti.promise;

            const isValid = fields.reduce(
              (valid, field) => validateField(field) && valid,
              true
            );

            if (!isValid) {
              form.querySelector<HTMLElement>(
                '[aria-invalid="true"]'
              )?.focus();

              return;
            }

            // Verify CAPTCHA token
            const captchaResponse =
              form.querySelector<HTMLTextAreaElement>(
                'textarea[name="h-captcha-response"]'
              )?.value.trim() ?? "";

            if (!captchaResponse) {
              showCaptchaError();
              return;
            }

            const accessKey =
              form.querySelector<HTMLInputElement>(
                'input[name="access_key"]'
              )?.value.trim() ?? "";

            if (!accessKey) {
              showResult(
                "The contact form is not configured yet. Please contact us directly.",
                "error"
              );
              return;
            }

            const formData = new FormData(form);

            formData.set("phone", iti.getNumber());
            formData.set("h-captcha-response", captchaResponse);

            const payload = Object.fromEntries(formData.entries());

            const controller = new AbortController();

            timeout = window.setTimeout(
              () => controller.abort(),
              20000
            );

            const response = await fetch(
              "https://api.web3forms.com/submit",
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(payload),
                signal: controller.signal,
              }
            );

            const data: {
              success?: boolean;
              message?: string;
            } = await response.json();

            if (!response.ok || !data.success) {
              throw new Error(
                data.message || "Unable to send your message."
              );
            }

            showResult(
              "Thank you. Your inquiry has been sent successfully.",
              "success"
            );

            form.reset();
            iti.setNumber("");
            iti.setSelectedCountry("in");
            phoneInput.value = "";

            fields.forEach(clearFieldError);

            // Reset hCaptcha after successful submission
            const captchaWindow = window as Window & {
              hcaptcha?: {
                reset?: () => void;
              };
            };

            captchaWindow.hcaptcha?.reset?.();

          } catch (error) {
            const message =
              error instanceof Error && error.name === "AbortError"
                ? "The request timed out. Please try again."
                : error instanceof Error
                  ? error.message
                  : "Something went wrong. Please try again.";

            showResult(message, "error");

          } finally {
            if (timeout !== undefined) {
              window.clearTimeout(timeout);
            }

            isSubmitting = false;
            submitButton.disabled = false;
            buttonLabel.textContent = "Send Message";
          }
        });
      });
  }

  initialiseContactForms();

  document.addEventListener("astro:page-load", initialiseContactForms);
</script>

<style>
  .contact-form .contact-input {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    border-radius: 0;
    background: transparent;
    padding-block: 1rem;
    color: white;
    font: inherit;
    outline: none;
    transition: border-color 180ms ease;
  }

  .contact-form .contact-input:focus {
    border-bottom-color: var(--color-accent, #b99a62);
  }

  .contact-form .contact-input[aria-invalid="true"] {
    border-bottom-color: #f87171;
  }

  .contact-form select.contact-input {
    color-scheme: dark;
  }

  .contact-form select option {
    background: #171717;
    color: white;
  }

  :global(.contact-form .iti) {
    display: block;
    width: 100%;
  }

  :global(.contact-form .iti input) {
    width: 100%;
    min-height: 3.25rem;
    border-radius: 0;
    background: transparent;
    color: white;
    font: inherit;
  }

  :global(.contact-form .iti input::placeholder) {
    color: rgb(255 255 255 / 40%);
  }

  :global(.contact-form .iti input:focus) {
    border-color: var(--color-accent, #b99a62);
    outline: none;
  }

  :global(.contact-form .iti input[aria-invalid="true"]) {
    border-color: #f87171;
  }

  :global(.contact-form .iti__dropdown-content),
  :global(.contact-form .iti__country-list),
  :global(.contact-form .iti__country) {
    background: #fff !important;
    color: #171717 !important;
    border-radius: 0 !important;
  }

  :global(.contact-form .iti__dropdown-content),
  :global(.contact-form .iti__country-list) {
    border-bottom: 1px solid #d1d5db;
  }

  :global(.contact-form .iti__country-name),
  :global(.contact-form .iti__dial-code) {
    color: #171717 !important;
  }

  :global(.contact-form .iti__dial-code) {
    opacity: 0.65;
  }

  :global(.contact-form .iti__country:hover),
  :global(.contact-form .iti__country.iti__highlight) {
    background: #f1f5f9 !important;
  }

  :global(.contact-form .iti__search-input) {
    border: 1px solid #d1d5db !important;
    border-radius: 0 !important;
    background: #fff !important;
    color: #171717 !important;
  }

  :global(.contact-form .iti__search-input::placeholder) {
    color: #6b7280 !important;
  }

  :global(.contact-form .iti__selected-country) {
    border-radius: 0;
  }

  :global(.contact-form .iti__selected-country-primary) {
    padding-left: 0.75rem;
  }
</style>
