
---
import Layout from "../layouts/Layout.astro";
import SplitGrid from '../components/blocks/SplitGrid.astro';
import TeamGrid from '../components/blocks/TeamGrid.astro';
import TimelineSlider from '../components/blocks/TimelineSlider.astro';
import CTA from '../components/blocks/CTA.astro';
import PageIntro from '../components/blocks/PageIntro.astro';
import VideoBlock from '../components/blocks/VideoBlock.astro';
import { sanityClient } from 'sanity:client';
import { siteSettingsQuery } from "../lib/queries";

// AI-generated: Fetch site settings for default SEO fallback
const settings = await sanityClient.fetch(siteSettingsQuery);
const defaultSeo = settings?.defaultSeo ?? {};

// AI-generated: Read all SEO properties with fallback to defaults
const seoTitle = defaultSeo.metaTitle;
const seoDescription = defaultSeo.metaDescription || "";
const canonicalUrl = defaultSeo.canonicalUrl || "/about";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  // AI-generated: Pass all SEO properties to the layout
  canonical={defaultSeo.canonicalUrl || undefined}
  noindex={defaultSeo.noIndex ?? undefined}
  ogTitle={defaultSeo.ogTitle ?? undefined}
  ogDescription={defaultSeo.ogDescription ?? undefined}
  ogImage={
    defaultSeo.ogImage?.url
      ? { url: defaultSeo.ogImage.url, alt: defaultSeo.ogImage.alt }
      : undefined
  }
>
    <PageIntro
    eyebrow="About Us"
    title="Since 1974" content={`
A leading and dedicated Power Presses manufacturing company committed to build long-lasting relationships with local and international business clients. The Mankoo Presses INDIA is a trusted name among the top rated suppliers of power press machines in UAE, Egypt, Iran, Mexico, Saudi Arabia and Middle East countries`}
    headingLevel="h1"
    />
<VideoBlock
  src="/landing.mp4"
  aspectRatio="21 / 9"
/>
 <SplitGrid />
 <TeamGrid />
 <TimelineSlider />
 <CTA />

</Layout>
