---
import Layout from "../layouts/Layout.astro";
import Hero from '../components/blocks/Hero.astro';
import SplitGrid from '../components/blocks/SplitGrid.astro';
import ProductCarousel from '../components/blocks/ProductCarousel.astro';
import FeaturedProduct from '../components/blocks/FeaturedProduct.astro';
import GridTabs from '../components/blocks/GridTabs.astro';
import Testimonial from '../components/blocks/Testimonial.astro';
import FeatureHighlights from '../components/blocks/FeatureHighlights.astro';
import LatestPosts from '../components/blocks/LatestPosts.astro';
import { sanityClient } from 'sanity:client';
import { homepageQuery } from "../lib/queries";

const page = await sanityClient.fetch(homepageQuery);

const hero = page?.sections?.find(
  (section) => section._type === "heroSection"
);
const splitGridSection = page?.sections?.find(
  (section) => section._type === "splitGridSection"
);
const newsSection = page?.sections?.find(
  (section) => section._type === "newsSection"
);
const testimonialSection = page?.sections?.find(
  (section) => section._type === "testimonialSection"
);
const productSlider = page?.sections?.find(
  (section) => section._type === "productSliderSection"
);
const featureHighlightsSection = page?.sections?.find(
  (section) => section._type === "featureHighlightsSection"
);
const featuredProduct = page?.sections?.find(
  (section) => section._type === "featuredProductSection"
);
const imageTransitionSection = page?.sections?.find(
  (section) => section._type === "imageTransitionSection"
);

const hasImageTransitionContent = Boolean(
  imageTransitionSection?.eyebrow?.trim() ||
  imageTransitionSection?.heading?.trim() ||
  imageTransitionSection?.slides?.some((slide) =>
    slide?.image?.url ||
    slide?.title?.trim() ||
    slide?.description?.trim()
  )
);
// SEO
const seoTitle =
  page?.seo?.metaTitle || page?.title || "Home | Mankoo";
const seoDescription =
  page?.seo?.metaDescription ||
  page?.title ||
  "";
const seoKeywords = page?.seo?.metaKeywords || "";
const canonicalUrl = page?.seo?.canonicalUrl || "/";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={page?.seo?.canonicalUrl || undefined}
  noindex={page?.seo?.noIndex ?? undefined}
  ogTitle={page?.seo?.ogTitle ?? undefined}
  ogDescription={page?.seo?.ogDescription ?? undefined}
  ogImage={
    page?.seo?.ogImage?.url
      ? { url: page.seo.ogImage.url, alt: page.seo.ogImage.alt }
      : undefined
  }
  metaKeywords={seoKeywords}
>
 {hero && (
    <Hero
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      heroMedia={hero.heroMedia}
      imageAlt={hero.imageAlt}
      primaryCta={hero.primaryCta}
    />
  )}
  
  <!-- <pre>{JSON.stringify(featuredProduct, null, 2)}</pre> -->

  {splitGridSection && <SplitGrid section={splitGridSection} />}
  {productSlider && (
    <ProductCarousel 
      eyebrow={productSlider.eyebrow}
      heading={productSlider.heading}
      products={productSlider.products}
    />
  )}
  {hasImageTransitionContent && (
    <GridTabs section={imageTransitionSection} />
  )}
  
  
  {featuredProduct && <FeaturedProduct {...featuredProduct} />}

 {featureHighlightsSection && (
    <FeatureHighlights section={featureHighlightsSection} />
  )}
 {testimonialSection && (
    <Testimonial section={testimonialSection} />
  )}
 {newsSection && <LatestPosts section={newsSection} />}
  <div class="border-b border-white/10 "></div>
</Layout>


<style>
  .hero-swiper .swiper-pagination {
    bottom: 28px;
  }

  .hero-swiper .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: white;
    opacity: 0.6;
  }

  .hero-swiper .swiper-pagination-bullet-active {
    width: 28px;
    border-radius: 8px;
    background: #f97316;
    opacity: 1;
  }
</style>
