---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import {
  productBySlugQuery,
  allProductSlugsQuery,
} from "../../lib/queries";

import CTA from "../../components/blocks/CTA.astro";
import PageIntro from "../../components/blocks/PageIntro.astro";
import PIllarCards from "../../components/blocks/PIllarCards.astro";
import ProductSpecifications from "../../components/blocks/ProductSpecifications.astro";
// Generated by AI
import ProductStats from "../../components/blocks/ProductStats.astro";
// /Generated by AI

export async function getStaticPaths() {
  const products = await sanityClient.fetch(allProductSlugsQuery);

  return products.map((product: { slug: string }) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const product = await sanityClient.fetch(productBySlugQuery, { slug });

if (!product) {
  return new Response("Product not found", { status: 404 });
}

const seoTitle =
  product.seo?.metaTitle || `${product.name} | Mankoo India`;

const seoDescription =
  product.seo?.metaDescription || product.shortDescription || "";

const canonical =
  product.seo?.canonicalUrl || `/product/${product.slug}`;

const hero = product.hero;
const pillars = product.pillars ?? [];
const numbers = product.keyNumbers ?? [];
const features = product.featureBlocks ?? [];
const bands = product.tonnageBands ?? [];
const applications = product.applications ?? [];
const models = product.specifications?.capacities ?? [];
const brochures = product.brochures ?? [];

const stats = product.productStats;

const buildFeature = features.find(
  (feature: any) => feature.featureType === "build"
);

const controlFeature = features.find(
  (feature: any) => feature.featureType === "control"
);

const otherFeatures = features.filter(
  (feature: any) =>
    feature.featureType !== "build" &&
    feature.featureType !== "control"
);

const requestedDefaultModel = product.specifications?.defaultModel;

const initialModel =
  models.find(
    (model: any) =>
      model.modelName === requestedDefaultModel ||
      model.modelTitle === requestedDefaultModel
  ) ?? models[0];

const initialModelKey = initialModel?._key;

const getModelLabel = (model: any) =>
  [model.modelName, model.modelTitle]
    .filter(Boolean)
    .join(" — ") || "Model";

const getKeySpecifications = (model: any) => {
  if (model?.keySpecifications?.length) {
    return model.keySpecifications;
  }

  return model?.specifications ?? [];
};

const getSpecificationGroups = (model: any) => {
  const groups = (model?.specificationGroups ?? []).filter(
    (group: any) => group.specifications?.length
  );

  if (groups.length) return groups;

  const legacyGroups = [];

  if (model?.specifications?.length) {
    legacyGroups.push({
      _key: "legacy-specifications",
      title: "Specifications",
      specifications: model.specifications,
    });
  }

  if (model?.additionalSpecifications?.specifications?.length) {
    legacyGroups.push({
      _key: "legacy-additional",
      title:
        model.additionalSpecifications.title ||
        "Additional Specifications",
      specifications: model.additionalSpecifications.specifications,
    });
  }

  return legacyGroups;
};

const plainText = (blocks: any[] = []) =>
  blocks
    .map((block) =>
      block._type === "block"
        ? (block.children ?? [])
            .map((child: any) => child.text ?? "")
            .join("")
        : ""
    )
    .filter(Boolean)
    .join("\n\n");

const descriptionText = plainText(product.description);

const firstBrochure = brochures.find((file: any) => file.url);

const brochureUrl = firstBrochure?.url;

const brochureLabel =
  hero?.brochureCtaLabel ||
  product.downloads?.brochureLabel ||
  "Download Brochure";

const foundationUrl = product.downloads?.foundationDrawingUrl;

const primaryCtaUrl = hero?.primaryCtaUrl || "/contact";

const finalCtaUrl = product.finalCta?.buttonUrl || "/contact";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
>
  <main class="product-page">
    <!-- 1. HERO -->
    <PageIntro 
      eyebrow={hero?.eyebrow ?? ''}
      title={hero?.heading || product.name}
      tagline={hero?.tagline ?? ''}
      content={hero?.subLine ?? ''}
     >
     </PageIntro>

     <PIllarCards
      introText={product.introText}
      highlightText={product.highlightText}
      pillars={product.pillars ?? []}
      ></PIllarCards>

    <!-- Generated by AI -->
    <ProductStats productStats={stats} keyNumbers={numbers} />
    <!-- /Generated by AI -->

     <ProductSpecifications specifications={product.specifications} />

    <!-- FINAL CTA -->
     {product.finalCta && (
      <CTA 
        title={product.finalCta?.heading ?? ''}
        text={product.finalCta?.copy ?? ''}
        ctaHref={product.finalCta?.buttonUrl ?? '/#'}
        ctaLabel={product.finalCta?.buttonLabel ?? 'Contact Us'}
        image={product.finalCta?.backgroundImage?.url ?? ''}
        imageAlt={product.finalCta?.backgroundImage?.alt ?? ''}
      >
      </CTA>
      )}
    
  </main>
</Layout>

<script>
  const setupProductPage = () => {
    // Model selector
    document.querySelectorAll<HTMLElement>(".specifications-section").forEach(
      (section) => {
        const selector =
          section.querySelector<HTMLSelectElement>("#model-selector");

        const panels =
          section.querySelectorAll<HTMLElement>("[data-model-panel]");

        if (!selector) return;

        const updateModel = () => {
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.modelPanel !== selector.value;
          });
        };

        selector.addEventListener("change", updateModel);
        updateModel();
      }
    );

    // Tonnage band selector
    document.querySelectorAll<HTMLElement>(".bands-section").forEach(
      (section) => {
        const buttons =
          section.querySelectorAll<HTMLButtonElement>("[data-band-button]");

        const panels =
          section.querySelectorAll<HTMLElement>("[data-band-panel]");

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const selectedBand = button.dataset.bandButton;

            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle("is-active", active);
              item.setAttribute("aria-pressed", String(active));
            });

            panels.forEach((panel) => {
              panel.hidden = panel.dataset.bandPanel !== selectedBand;
            });
          });
        });
      }
    );

    // Specification accordion indicator
    document.querySelectorAll<HTMLDetailsElement>(".spec-group").forEach(
      (details) => {
        const updateIcon = () => {
          const icon = details.querySelector<HTMLElement>(
            ".spec-group__icon"
          );

          if (icon) icon.textContent = details.open ? "−" : "+";
        };

        details.addEventListener("toggle", updateIcon);
        updateIcon();
      }
    );
  };

  setupProductPage();
</script>
