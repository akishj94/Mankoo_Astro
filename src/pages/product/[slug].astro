---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import {
  productBySlugQuery,
  allProductSlugsQuery,
} from "../../lib/queries";

import CTA from "../../components/blocks/CTA.astro";
import PageIntro from "../../components/blocks/PageIntro.astro";
import PIllarCards from "../../components/blocks/PIllarCards.astro";
import ProductSpecifications from "../../components/blocks/ProductSpecifications.astro";
import FeatureColumns from "../../components/blocks/FeatureColumns.astro";
import ButtonGrid from "../../components/blocks/ButtonGrid.astro";
import ProductStats from "../../components/blocks/ProductStats.astro";
import ProductApplications from "../../components/blocks/ProductApplications.astro";


export async function getStaticPaths() {
  const products = await sanityClient.fetch(allProductSlugsQuery);

  return products.map((product: { slug: string }) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const product = await sanityClient.fetch(productBySlugQuery, { slug });

if (!product) {
  return new Response("Product not found", { status: 404 });
}

const seoTitle =
  product.seo?.metaTitle || `${product.name} | Mankoo India`;

const seoDescription =
  product.seo?.metaDescription || product.shortDescription || "";

const seoKeywords = product.seo?.metaKeywords || "";
const canonical =
  product.seo?.canonicalUrl || `/product/${product.slug}`;

const hero = product.hero;

const numbers = product.keyNumbers ?? [];

const brochures = (product.brochures ?? []).map((brochure: any) => ({
  _key: brochure._key,
  label: brochure.label,
  file: brochure.file,
}));

const primaryCtaHref =
  hero?.primaryCtaLinkType === "external"
    ? hero.primaryCtaExternalUrl
    : hero?.primaryCtaInternalLink?._type === "product"
      ? `/product/${hero.primaryCtaInternalLink.slug?.current ?? ""}`
      : hero?.primaryCtaInternalLink?._type === "post"
        ? `/blog/${hero.primaryCtaInternalLink.slug?.current ?? ""}`
        : hero?.primaryCtaInternalLink?._type === "page"
          ? `/${hero.primaryCtaInternalLink.slug?.current ?? ""}`
          : undefined;


const stats = product.productStats;

const plainText = (blocks: any[] = []) =>
  blocks
    .map((block) =>
      block._type === "block"
        ? (block.children ?? [])
            .map((child: any) => child.text ?? "")
            .join("")
        : ""
    )
    .filter(Boolean)
    .join("\n\n");
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  metaKeywords={seoKeywords}
>
  <main class="product-page">
    <!-- 1. HERO -->
    <PageIntro 
      eyebrow={hero?.eyebrow ?? ''}
      title={hero?.heading || product.name}
      tagline={hero?.tagline ?? ''}
      content={hero?.subLine ?? ''}
     >
     </PageIntro>

     
    {/* Product Video */}
    <div class="container">
      <div class="aspect-[16/8] relative overflow-hidden mt-[calc(clamp(1.5rem,3.5vw,2.5rem)*-1.1)]">
        {hero?.backgroundVideo ? (
          <video
            class="absolute inset-0 size-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          >
            <source src={hero.backgroundVideo} type="video/mp4" />
          </video>
        ) : product.featuredImage?.url ? (
          <img
            class="absolute inset-0 size-full object-cover"
            src={product.featuredImage.url}
            alt={product.featuredImage.alt || product.name}
            width={product.featuredImage.dimensions?.width || 1600}
            height={product.featuredImage.dimensions?.height || 900}
            fetchpriority="high"
            decoding="async"
          />
        ) : null}
      </div>
    </div>
    {/* Product Video */}

     <PIllarCards
      introText={product.introText}
      highlightText={product.highlightText}
      pillars={product.pillars ?? []}
      ></PIllarCards>

    <ProductStats productStats={stats} keyNumbers={numbers} />

    <FeatureColumns featureBlocks={product.featureBlocks ?? []} />
    <ProductApplications />
    <ProductSpecifications specifications={product.specifications} />

    <ButtonGrid
      brochures={brochures}
      ctaLabel={hero?.primaryCtaLabel}
      ctaHref={primaryCtaHref}
    />

    <!-- FINAL CTA -->
     {product.finalCta && (
      <CTA 
        title={product.finalCta?.heading ?? ''}
        text={product.finalCta?.copy ?? ''}
        ctaHref={product.finalCta?.buttonUrl ?? '/#'}
        ctaLabel={product.finalCta?.buttonLabel ?? 'Contact Us'}
        image={product.finalCta?.backgroundImage?.url ?? ''}
        imageAlt={product.finalCta?.backgroundImage?.alt ?? ''}
      >
      </CTA>
      )}
      
  </main>
</Layout>

<script>
  const setupProductPage = () => {
    // Model selector
    document.querySelectorAll<HTMLElement>(".specifications-section").forEach(
      (section) => {
        const selector =
          section.querySelector<HTMLSelectElement>("#model-selector");

        const panels =
          section.querySelectorAll<HTMLElement>("[data-model-panel]");

        if (!selector) return;

        const updateModel = () => {
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.modelPanel !== selector.value;
          });
        };

        selector.addEventListener("change", updateModel);
        updateModel();
      }
    );

    // Tonnage band selector
    document.querySelectorAll<HTMLElement>(".bands-section").forEach(
      (section) => {
        const buttons =
          section.querySelectorAll<HTMLButtonElement>("[data-band-button]");

        const panels =
          section.querySelectorAll<HTMLElement>("[data-band-panel]");

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const selectedBand = button.dataset.bandButton;

            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle("is-active", active);
              item.setAttribute("aria-pressed", String(active));
            });

            panels.forEach((panel) => {
              panel.hidden = panel.dataset.bandPanel !== selectedBand;
            });
          });
        });
      }
    );

    // Specification accordion indicator
    document.querySelectorAll<HTMLDetailsElement>(".spec-group").forEach(
      (details) => {
        const updateIcon = () => {
          const icon = details.querySelector<HTMLElement>(
            ".spec-group__icon"
          );

          if (icon) icon.textContent = details.open ? "−" : "+";
        };

        details.addEventListener("toggle", updateIcon);
        updateIcon();
      }
    );
  };

  setupProductPage();
</script>
