---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import {
  productBySlugQuery,
  allProductSlugsQuery,
} from "../../lib/queries";

export async function getStaticPaths() {
  const products = await sanityClient.fetch(allProductSlugsQuery);

  return products.map((product: { slug: string }) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const product = await sanityClient.fetch(productBySlugQuery, { slug });

if (!product) {
  return new Response("Product not found", { status: 404 });
}

const seoTitle =
  product.seo?.metaTitle || `${product.name} | Mankoo India`;

const seoDescription =
  product.seo?.metaDescription ||
  product.shortDescription ||
  "";

const canonical =
  product.seo?.canonicalUrl || `/product/${product.slug}`;

const models = product.specifications?.capacities ?? [];
const initialModel = models[0]?._key;

const descriptionBlocks = Array.isArray(product.description)
  ? product.description
  : [];

const plainText = (blocks: any[]) =>
  blocks
    .map((block) =>
      block._type === "block"
        ? (block.children ?? []).map((child: any) => child.text ?? "").join("")
        : ""
    )
    .filter(Boolean)
    .join("\n\n");
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
>
  <main class="container py-24">
    <section class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        {product.featuredImage?.url && (
          <figure class="overflow-hidden bg-neutral-100">
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.alt || product.name}
              width={product.featuredImage.dimensions?.width || 1000}
              height={product.featuredImage.dimensions?.height || 1000}
              fetchpriority="high"
              decoding="async"
              class="w-full object-cover"
            />
          </figure>
        )}

        {product.gallery?.length > 0 && (
          <div class="mt-4 grid grid-cols-3 gap-4">
            {product.gallery.map((image: any) => (
              image.url && (
                <figure class="overflow-hidden bg-neutral-100">
                  <img
                    src={image.url}
                    alt={image.alt || product.name}
                    width={400}
                    height={400}
                    loading="lazy"
                    decoding="async"
                    class="w-full object-cover"
                  />
                </figure>
              )
            ))}
          </div>
        )}
      </div>

      <div>
        <h1 class="text-3xl font-semibold tracking-tight">
          {product.name}
        </h1>

        {product.modelNumber && (
          <p class="mt-3 text-sm text-ink/60">
            Model: {product.modelNumber}
          </p>
        )}

        {product.shortDescription && (
          <p class="mt-6 text-lg leading-relaxed text-ink/60">
            {product.shortDescription}
          </p>
        )}

        {product.inquiryMessage && (
          <p class="mt-6 leading-relaxed text-ink/70">
            {product.inquiryMessage}
          </p>
        )}

        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center bg-accent px-6 py-3 font-medium text-white"
        >
          {product.inquiryCtaLabel || "Enquire Now"}
        </a>

        {product.brochures?.length > 0 && (
          <div class="mt-8">
            <h2 class="text-lg font-semibold">Product Brochures</h2>
            <ul class="mt-3 space-y-3">
              {product.brochures.map((brochure: any) => (
                brochure.url && (
                  <li>
                    <a
                      href={brochure.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent underline underline-offset-4"
                    >
                      {brochure.filename || "Download brochure"}
                    </a>
                  </li>
                )
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    {descriptionBlocks.length > 0 && (
      <section class="mt-20 max-w-4xl">
        <h2 class="text-2xl font-semibold tracking-tight">
          About {product.name}
        </h2>
        <div class="mt-6 whitespace-pre-line leading-relaxed text-ink/70">
          {plainText(descriptionBlocks)}
        </div>
      </section>
    )}

    {models.length > 0 && (
      <section class="technical-specifications mt-24">
        <header class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">
              {product.specifications?.heading || "Technical Specifications"}
            </h2>

            {product.specifications?.subtitle && (
              <p class="mt-4 max-w-2xl leading-relaxed text-ink/60">
                {product.specifications.subtitle}
              </p>
            )}
          </div>

          <div class="grid gap-2 md:min-w-64">
            <label for="model-selector" class="text-sm font-medium">
              Select Model
            </label>
            <select
              id="model-selector"
              class="min-h-12 border border-neutral-300 bg-white px-4 py-3"
            >
              {models.map((model: any, index: number) => (
                <option
                  value={model._key}
                  selected={index === 0}
                >
                  {[model.modelTitle, model.modelName]
                    .filter(Boolean)
                    .join(" — ") || `Model ${index + 1}`}
                </option>
              ))}
            </select>
          </div>
        </header>

        {models.map((model: any, index: number) => (
          <div
            class="model-specifications"
            data-model={model._key}
            hidden={index !== 0}
          >
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {(model.specifications ?? []).map((row: any) => (
                <div class="flex min-h-28 flex-col justify-between gap-4 border border-neutral-200 p-5">
                  <span class="text-sm text-ink/60">{row.label}</span>
                  <span class="break-words text-xl font-semibold">
                    {[row.value, row.unit].filter(Boolean).join(" ")}
                  </span>
                </div>
              ))}
            </div>

            {model.additionalSpecifications?.specifications?.length > 0 && (
              <div class="mt-10">
                <h3 class="mb-5 text-xl font-semibold">
                  {model.additionalSpecifications.title || "Additional Specifications"}
                </h3>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {model.additionalSpecifications.specifications.map((row: any) => (
                    <div class="flex min-h-28 flex-col justify-between gap-4 border border-neutral-200 p-5">
                      <span class="text-sm text-ink/60">{row.label}</span>
                      <span class="break-words text-xl font-semibold">
                        {[row.value, row.unit].filter(Boolean).join(" ")}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </section>
    )}

    {product.relatedProducts?.length > 0 && (
      <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight">
          Related Products
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {product.relatedProducts.map((related: any) => (
            <a
              href={`/product/${related.slug}`}
              class="group block"
            >
              {related.featuredImage?.url && (
                <figure class="aspect-[4/5] overflow-hidden bg-neutral-100">
                  <img
                    src={related.featuredImage.url}
                    alt={related.featuredImage.alt || related.name}
                    width={600}
                    height={750}
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </figure>
              )}

              <h3 class="mt-4 text-lg font-medium group-hover:text-accent">
                {related.name}
              </h3>

              {related.shortDescription && (
                <p class="mt-2 text-sm leading-relaxed text-ink/60">
                  {related.shortDescription}
                </p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <script>
    document.querySelectorAll(".technical-specifications").forEach((section) => {
      const selector =
        section.querySelector<HTMLSelectElement>("#model-selector");

      const panels =
        section.querySelectorAll<HTMLElement>(".model-specifications");

      selector?.addEventListener("change", () => {
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.model !== selector.value;
        });
      });
    });
  </script>

  <style>
    .model-specifications[hidden] {
      display: none;
    }
  </style>
</Layout>
